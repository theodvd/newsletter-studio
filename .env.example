# ═══════════════════════════════════════════════════════════
# Newsletter Studio — variables d'environnement
# Copier vers .env.local (dev) ou .env (docker) et remplir.
# JAMAIS de clé en dur dans le code : tout passe par ce fichier.
# ═══════════════════════════════════════════════════════════

# ── Supabase (projet newsletter-studio / votre-projet) ──
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : réservée au backend (provisioning, moteur). Ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (agent d'onboarding Lia + curation) ──
ANTHROPIC_API_KEY=

# ── Exa (recherche de sources & find-similar) ──
EXA_API_KEY=

# ── n8n (création des workflows par utilisateur) ──
N8N_API_URL=https://n8n.exemple.com
# Clé API n8n : Settings → n8n API → Create API key
N8N_API_KEY=
# ID du sous-workflow "Veille Engine — Moteur partagé"
N8N_ENGINE_WORKFLOW_ID=FcWnRuCpmFOhO002

# ── Canaux de livraison ──
# App Slack "Newsletter Studio" (OAuth incoming-webhook, multi-workspace)
# Créer l'app sur api.slack.com/apps → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# (legacy) Bot token — encore utilisé par le moteur pour les destinations
# de type channel ID ; les nouvelles veilles passent par webhook OAuth
SLACK_BOT_TOKEN=
# Brevo (emails transactionnels) — déjà utilisé par le workflow Growfin
BREVO_API_KEY=
# Expéditeur des emails
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lia Veille

# ── Chiffrement des clés API des sources (AES-256-GCM) ──
# Générer avec : openssl rand -hex 32
SOURCE_KEY_ENCRYPTION_SECRET=

# ── Observabilité ──
LANGFUSE_HOST=https://langfuse.exemple.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# URL publique de l'app (liens magic link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
