# ═══════════════════════════════════════════════════════════
# Newsletter Studio, variables d'environnement
# Copier vers .env.local (dev) ou .env (docker), puis remplir.
# Aucune clé en dur dans le code : tout passe par ce fichier.
# ═══════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : réservée au serveur. Ne jamais l'exposer côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Onboarding avec Lia ─────────────────────────────────────
# Seule dépense à la charge de l'hébergeur : la conversation de configuration.
# Les éditions, elles, tournent sur la clé de chaque utilisateur (BYOK).
ANTHROPIC_API_KEY=
# Recherche de sources pendant l'onboarding (https://exa.ai). Optionnel :
# sans clé, Lia se limite à l'autodiscovery RSS des sources citées.
EXA_API_KEY=

# ── Moteur de veille ────────────────────────────────────────
# Secret du déclencheur. Générer avec : openssl rand -hex 32
# Puis, côté système : */5 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://votre-app/api/cron/tick
CRON_SECRET=
# Fuseau dans lequel les crons des veilles sont interprétés.
ENGINE_TIMEZONE=Europe/Paris
# Clé de secours de l'hébergeur, pour les comptes listés ci-dessous uniquement.
# Sans la liste, elle ne s'applique à personne : c'est délibéré, sinon un
# utilisateur pourrait brancher sa clé, activer sa veille, la retirer, et
# faire payer l'hébergeur indéfiniment. Laisser vide pour imposer le BYOK.
ENGINE_FALLBACK_API_KEY=
ENGINE_FALLBACK_PROVIDER=anthropic
ENGINE_FALLBACK_USER_IDS=
# Forcer un modèle précis (sinon : claude-sonnet-4-6 ou gpt-5 selon le fournisseur)
ENGINE_MODEL=
# Endpoint compatible OpenAI autre qu'OpenAI (Groq, OpenRouter, modèle local...)
ENGINE_OPENAI_BASE_URL=

# ── Bornes de service ───────────────────────────────────────
# Plafonds de dépense HEBDOMADAIRES sur la clé de l'hébergeur (onboarding
# uniquement : les éditions sont payées par chaque utilisateur).
# Le plafond global est le garde-fou qui compte dès que les inscriptions
# sont ouvertes : c'est la seule borne entre une vague de comptes et une
# facture non bornée. Atteint, l'onboarding est suspendu jusqu'au lundi.
WEEKLY_CAP_USD_PER_USER=1
WEEKLY_CAP_USD_GLOBAL=10
# Bornes structurelles
LIMIT_ACTIVE_DIGESTS=3
LIMIT_SOURCES_PER_DIGEST=12

# ── Canaux de livraison ─────────────────────────────────────
# Brevo, pour les emails. L'expéditeur DOIT être validé dans Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lia Veille
# App Slack (OAuth incoming-webhook, multi-workspace).
# api.slack.com/apps → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Token bot, pour les anciennes veilles dont la destination est un id de canal.
SLACK_BOT_TOKEN=

# ── Chiffrement ─────────────────────────────────────────────
# Protège les clés API des utilisateurs et des sources (AES-256-GCM).
# Générer avec : openssl rand -hex 32
# Le perdre rend toutes les clés stockées illisibles.
SOURCE_KEY_ENCRYPTION_SECRET=

# ── Anti-bot (Cloudflare Turnstile) ─────────────────────────
# Widget à créer sur dash.cloudflare.com > Turnstile, en listant le ou les
# domaines servant la page de connexion. Sans ces clés, l'app fonctionne mais
# l'inscription est ouverte aux robots.
# La clé de site est PUBLIQUE (elle part dans le navigateur), et doit être
# disponible AU BUILD : elle est passée en argument dans docker-compose.yml.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# La clé secrète ne se met PAS ici : elle se colle dans Supabase
# (Authentication > Attack Protection > Enable Captcha protection).

# ── Surveillance des abus ───────────────────────────────────
# Adresses autorisées à ouvrir /admin/flags, séparées par des virgules.
# Vide = aucun administrateur, la console est inaccessible (404).
ADMIN_EMAILS=
# Destinataire de l'alerte quand une conversation est signalée (détournement
# de l'agent, recherche de secrets, sondage du réseau interne). Vide = pas
# d'alerte, mais le signalement reste consultable dans la console.
# Rappel : seules les conversations SIGNALÉES sont enregistrées, et elles sont
# supprimées au bout de 30 jours. Si vous exploitez cette app publiquement,
# mentionnez-le dans votre politique de confidentialité.
ABUSE_ALERT_EMAIL=

# ── Divers ──────────────────────────────────────────────────
# URL publique de l'app, utilisée dans les emails de connexion.
NEXT_PUBLIC_APP_URL=http://localhost:3000
